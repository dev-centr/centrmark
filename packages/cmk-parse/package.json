{
  "name": "@centrmark/parse",
  "version": "0.1.0",
  "private": false,
  "description": "Parse CentrMark (.cmk) to canonical AST JSON via centrmark-cli",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm exec tsc -p tsconfig.json",
    "test": "node --test ./tests/*.test.mjs"
  },
  "dependencies": {
    "@centrmark/cmk-renderer": "file:../cmk-renderer"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}
